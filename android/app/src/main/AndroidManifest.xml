<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Helm is an SSH client: every session opens a TCP socket to a remote
         host, so this permission is required in every build type. It is also
         declared in the debug manifest for the Flutter tool's own tooling
         channel, but that declaration does not reach release or profile
         builds. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- ── Holding a session open in the background ──────────────────────

         All three are NORMAL permissions: granted at install time, with no
         runtime prompt and no way for the user to revoke them. Nothing
         here adds a dialog.

         FOREGROUND_SERVICE is the base requirement for any foreground
         service since Android 9.

         FOREGROUND_SERVICE_CONNECTED_DEVICE is required from Android 14
         for the `connectedDevice` type declared on the service below.
         `connectedDevice` rather than the intuitive `dataSync` because
         Android 15 caps dataSync at six CUMULATIVE hours per 24 and then
         refuses to start another until the next day — a feature built on
         it would work, then die every afternoon. `connectedDevice` has no
         timeout, and its documented scope covers interactions with
         external devices over "a Bluetooth, NFC, IR, USB, or network
         connection", which is what an SSH session to a Mac is.

         CHANGE_NETWORK_STATE satisfies `connectedDevice`'s runtime
         prerequisite, which is an any-of list. The framework
         (ForegroundServiceTypePolicy.java) accepts CHANGE_NETWORK_STATE,
         CHANGE_WIFI_STATE, NFC, TRANSMIT_IR, a granted Bluetooth/UWB
         runtime permission, or a USB device grant. Every alternative
         either prompts the user or claims hardware helm does not touch,
         so this is the only honest entry on that list. Without it the
         start throws ForegroundServiceStartNotAllowedException.

         Deliberately ABSENT: REQUEST_IGNORE_BATTERY_OPTIMIZATIONS. Play
         prohibits it unless the app's core function is adversely affected
         without it, and it would buy nothing — a running foreground
         service is already listed as "No restrictions" in Android's
         power-management table and already pins the app to the Active
         standby bucket. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <application
        android:label="helm"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Keeps helm's process alive so the SSH connection it already
             holds survives being backgrounded.

             No `android:process`, and that omission is the whole design.
             Without it the service runs in the application's DEFAULT
             process — the one hosting MainActivity, its FlutterEngine,
             and the isolate that owns the socket — so raising this
             service's importance raises theirs. Naming a process here
             would put the service somewhere the connection is not, and
             force the second-FlutterEngine, second-SSH-connection design
             that every Flutter background-service plugin has to use.

             `exported="false"`: nothing outside this app has any reason
             to start it, and an exported foreground service is a way for
             another app to make this one hold a notification.

             `stopWithTask` is left at its default of false ON PURPOSE.
             Setting it true kills the service without calling
             onTaskRemoved, which is where the hold tears itself down and
             removes its notification — see SessionHoldService. -->
        <service
            android:name=".SessionHoldService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"/>
        <!-- Which channel the Firebase SDK draws a backgrounded
             notification on.

             The value must equal `kAgentAlertChannelId` in
             lib/features/notifications/data/local_notification_presenter.dart,
             which is the channel the app creates at startup and the one
             the FOREGROUND path posts on.

             Required rather than cosmetic. Without it the SDK falls back
             to its own `fcm_fallback_notification_channel`, labelled
             "Miscellaneous", so one feature would appear as two entries
             in Android's notification settings — and muting "Agent
             alerts" would not stop the notifications that arrive while
             helm is closed, which are the only ones that matter.

             Verified against firebase-messaging-25.0.1.aar: the SDK reads
             exactly this meta-data name. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="helm_agent_alerts" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
